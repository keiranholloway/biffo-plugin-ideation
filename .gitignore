# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Node (the /ideation frontend, added later)
node_modules/
.next/
out/

# Env / local
.env
.env.*
!.env.example
*.tsbuildinfo

# Per-unit-of-work worktrees (AGENTS.md §1). Git-ignored so they are never
# committed and never double-scanned by a linter or type-checker.
.worktrees/

# Terraform
.terraform
.terraform.lock.hcl
.terraformrc
terraform.rc

# Coverage artefacts (#146). `.coverage` is the sqlite datafile;
# `coverage.json`/`coverage.xml` are regenerated by every CI run and by
# `scripts/error_branch_coverage.py --write` locally when re-taking the
# baseline -- the baseline itself (docs/practices/error-branch-baseline.json)
# is the only one of these that is committed.
.coverage
coverage.json
coverage.xml
